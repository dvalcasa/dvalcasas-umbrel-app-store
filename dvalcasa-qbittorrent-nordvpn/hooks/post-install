#!/usr/bin/env bash
set -euo pipefail

echo "inside qbittorrent/hooks/post-install"

APP_DATA_DIR="$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")"
QBITTORRENT_CONF_FILE="${APP_DATA_DIR}/data/config/config/qBittorrent.conf"

# Wait up to 30 seconds for the qBittorrent.conf file to exist
echo "Waiting up to 30 seconds for qBittorrent.conf file to exist..."
for attempt in $(seq 1 300); do
	if [[ -f "${QBITTORRENT_CONF_FILE}" ]]; then
		echo "qBittorrent.conf file exists"
		break
	fi
	sleep 0.1
done

# wait 5 seconds to be extra sure the file is fully written by the qBittorrent service
echo "Waiting 5 seconds for qBittorrent.conf file to be fully written..."
sleep 5

if [[ ! -f "${QBITTORRENT_CONF_FILE}" ]]; then
  echo "[ERROR] qBittorrent.conf was never created. Something is likely wrong with the qBittorrent app."
  exit
fi

ensure_bittorrent_section() {
	if ! grep --quiet '^\[BitTorrent\]$' "${QBITTORRENT_CONF_FILE}"; then
		echo "[BitTorrent] section does not exist in qBittorrent.conf. Creating it."
		printf '\n[BitTorrent]\n' >> "${QBITTORRENT_CONF_FILE}"
	fi
}

ensure_webui_section() {
	if ! grep --quiet '^\[WebUI\]$' "${QBITTORRENT_CONF_FILE}"; then
		echo "[WebUI] section does not exist in qBittorrent.conf. Creating it."
		printf '\n[WebUI]\n' >> "${QBITTORRENT_CONF_FILE}"
	fi
}

# qBittorrent 5.3 stores these settings in [Preferences]
# with Preferences-prefixed keys. Upstream migrates existing settings before this hook.
ensure_preferences_section() {
	if ! grep --quiet '^\[Preferences\]$' "${QBITTORRENT_CONF_FILE}"; then
		echo "[Preferences] section does not exist in qBittorrent.conf. Creating it."
		printf '\n[Preferences]\n' >> "${QBITTORRENT_CONF_FILE}"
	fi
}

ensure_bittorrent_section

echo "Setting Session/DefaultSavePath=/downloads/complete in qBittorrent.conf"
if grep -q '^Session\\DefaultSavePath=' "${QBITTORRENT_CONF_FILE}"; then
  sed -i 's|^Session\\DefaultSavePath=.*|Session\\DefaultSavePath=/downloads/complete|' "${QBITTORRENT_CONF_FILE}"
else
  sed -i '/^\[BitTorrent\]/a Session\\DefaultSavePath=/downloads/complete' "${QBITTORRENT_CONF_FILE}"
fi

echo "Setting Session/TempPath=/downloads/incomplete in qBittorrent.conf"
if grep -q '^Session\\TempPath=' "${QBITTORRENT_CONF_FILE}"; then
  sed -i 's|^Session\\TempPath=.*|Session\\TempPath=/downloads/incomplete|' "${QBITTORRENT_CONF_FILE}"
else
  sed -i '/^\[BitTorrent\]/a Session\\TempPath=/downloads/incomplete' "${QBITTORRENT_CONF_FILE}"
fi

echo "Setting Session/TempPathEnabled=true in qBittorrent.conf"
if grep -q '^Session\\TempPathEnabled=' "${QBITTORRENT_CONF_FILE}"; then
  sed -i 's|^Session\\TempPathEnabled=.*|Session\\TempPathEnabled=true|' "${QBITTORRENT_CONF_FILE}"
else
  sed -i '/^\[BitTorrent\]/a Session\\TempPathEnabled=true' "${QBITTORRENT_CONF_FILE}"
fi

echo "Setting Session/Interface=tun0 in qBittorrent.conf"
if grep -q '^Session\\Interface=' "${QBITTORRENT_CONF_FILE}"; then
  sed -i 's|^Session\\Interface=.*|Session\\Interface=tun0|' "${QBITTORRENT_CONF_FILE}"
else
  sed -i '/^\[BitTorrent\]/a Session\\Interface=tun0' "${QBITTORRENT_CONF_FILE}"
fi

echo "Setting Session/InterfaceName=tun0 in qBittorrent.conf"
if grep -q '^Session\\InterfaceName=' "${QBITTORRENT_CONF_FILE}"; then
  sed -i 's|^Session\\InterfaceName=.*|Session\\InterfaceName=tun0|' "${QBITTORRENT_CONF_FILE}"
else
  sed -i '/^\[BitTorrent\]/a Session\\InterfaceName=tun0' "${QBITTORRENT_CONF_FILE}"
fi

# Users can overwrite these settings in the qBittorrent.conf file if they want to change them and this script won't overwrite them.

ensure_webui_section

# Enable reverse proxy support so qBittorrent reads the real client IP from X-Forwarded-For
# and checks that against AuthSubnetWhitelist instead of the direct connection IP.
# This allows third-party apps (e.g. qRemote) to authenticate with qBittorrent natively
# while still allowing internal apps (Radarr, Sonarr, etc.) to bypass auth via the subnet whitelist.

# Ensure WebUI/ReverseProxySupportEnabled is set correctly
echo "Setting WebUI/ReverseProxySupportEnabled=true in qBittorrent.conf"
if grep -q '^ReverseProxySupportEnabled=' "${QBITTORRENT_CONF_FILE}"; then
  sed -i 's/^ReverseProxySupportEnabled=.*/ReverseProxySupportEnabled=true/' "${QBITTORRENT_CONF_FILE}"
else
  sed -i '/^\[WebUI\]/a ReverseProxySupportEnabled=true' "${QBITTORRENT_CONF_FILE}"
fi

# Ensure WebUI/TrustedReverseProxiesList is set correctly
echo "Setting WebUI/TrustedReverseProxiesList=10.21.0.0/16 in qBittorrent.conf"
if grep -q '^TrustedReverseProxiesList=' "${QBITTORRENT_CONF_FILE}"; then
  sed -i 's/^TrustedReverseProxiesList=.*/TrustedReverseProxiesList=10.21.0.0\/16/' "${QBITTORRENT_CONF_FILE}"
else
  sed -i '/^\[WebUI\]/a TrustedReverseProxiesList=10.21.0.0/16' "${QBITTORRENT_CONF_FILE}"
fi

# This script will set the default password to the legacy 'adminadmin' password if the password is not already set. If a user has already set a password, this script will not overwrite it.
# The app description in the Umbrel app store encourages users to change the default password.

# If a line with `WebUI/Password_PBKDF2` does not exist yet in the qBittorrent.conf, then a custom password hasn't been set yet and we write out `adminadmin` as the default password.
# This line is expected to be under the [WebUI] section.
# We check for this line first because a user may have a legacy install from before qBittorrent removed the default password.
if ! grep --quiet '^Password_PBKDF2' "${QBITTORRENT_CONF_FILE}"; then
  echo "Password_PBKDF2 does not exist in qBittorrent.conf. Adding default password."

  echo "Writing default password adminadmin to qBittorrent.conf"
  sed -i '/^\[WebUI\]/a Password_PBKDF2="@ByteArray(gTzqQHUv3A1X43tLaAhaJQ==:ZBCIBA4honNZ7H66xdEoHpqBC/Vvwj17ZCjQKARSK78ScJWDMdWSfxezHG536UekAL/zpRn571MXCfhtdqiArA==)"' "${QBITTORRENT_CONF_FILE}"

else
  # This is a legacy install and the user has already set a password. We don't want to overwrite it. 
  echo "'Password_PBKDF2' already exists in qBittorrent.conf. No changes made."
fi

# Ensure WebUI/AuthSubnetWhitelist is set correctly
echo "Setting AuthSubnetWhitelist=10.21.0.0/16 in qBittorrent.conf"
if grep -q '^AuthSubnetWhitelist=' "${QBITTORRENT_CONF_FILE}"; then
  sed -i 's/^AuthSubnetWhitelist=.*/AuthSubnetWhitelist=10.21.0.0\/16/' "${QBITTORRENT_CONF_FILE}"
else
  sed -i '/^\[WebUI\]/a AuthSubnetWhitelist=10.21.0.0/16' "${QBITTORRENT_CONF_FILE}"
fi

# Ensure WebUI/AuthSubnetWhitelistEnabled is set correctly
echo "Setting WebUI/AuthSubnetWhitelistEnabled=true in qBittorrent.conf"
if grep -q '^AuthSubnetWhitelistEnabled=' "${QBITTORRENT_CONF_FILE}"; then
  sed -i 's/^AuthSubnetWhitelistEnabled=.*/AuthSubnetWhitelistEnabled=true/' "${QBITTORRENT_CONF_FILE}"
else
  sed -i '/^\[WebUI\]/a AuthSubnetWhitelistEnabled=true' "${QBITTORRENT_CONF_FILE}"
fi

# Ensure WebUI/HostHeaderValidation is set correctly
echo "Setting WebUI/HostHeaderValidation=false in qBittorrent.conf"
if grep -q '^HostHeaderValidation=' "${QBITTORRENT_CONF_FILE}"; then
  sed -i 's/^HostHeaderValidation=.*/HostHeaderValidation=false/' "${QBITTORRENT_CONF_FILE}"
else
  sed -i '/^\[WebUI\]/a HostHeaderValidation=false' "${QBITTORRENT_CONF_FILE}"
fi

ensure_preferences_section

echo "Setting General/StatusbarExternalIPDisplayed=true in qBittorrent.conf"
if grep -q '^General\\StatusbarExternalIPDisplayed=' "${QBITTORRENT_CONF_FILE}"; then
  sed -i 's|^General\\StatusbarExternalIPDisplayed=.*|General\\StatusbarExternalIPDisplayed=true|' "${QBITTORRENT_CONF_FILE}"
else
  sed -i '/^\[Preferences\]/a General\\StatusbarExternalIPDisplayed=true' "${QBITTORRENT_CONF_FILE}"
fi

echo "qbittorrent/hooks/post-install done"
